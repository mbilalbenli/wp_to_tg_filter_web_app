# Kopyalayın: cp .env.example .env  — gerçek sırları commit etmeyin.

# --- Admin (panel girişi) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=wp_to_tg159753
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# --- Backend ---
BACKEND_PORT=8000
DATABASE_URL=sqlite:////data/app.db

# --- OpenWA (WhatsApp) ---
# İmaj adı github.com/rmyndharis/OpenWA üzerinden doğrulanmalıdır.
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:latest
OPENWA_PORT=2785
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=
# Public HTTPS olmali (OpenWA SSRF korumasi ic adresleri reddeder):
# OPENWA_WEBHOOK_URL=https://wp-tg-filter.mbbe.dev/api/webhook/openwa
OPENWA_WEBHOOK_URL=

# --- Telegram (varsayılanlar boş; asıl token/chat_id panelden hedef olarak girilir) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cloudflare Tunnel (opsiyonel, profile: tunnel) ---
# Domain: wp-tg-filter.mbbe.dev
TUNNEL_TOKEN=
